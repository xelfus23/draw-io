        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{\n  init: {\n    &#39;theme&#39;: &#39;base&#39;,\n    &#39;layout&#39;: &#39;elk&#39;,\n    &#39;themeVariables&#39;: {\n      &#39;primaryColor&#39;: &#39;#ffffff&#39;,\n      &#39;primaryBorderColor&#39;: &#39;#1e293b&#39;,\n      &#39;primaryTextColor&#39;: &#39;#0f172a&#39;,\n      &#39;lineColor&#39;: &#39;#475569&#39;,\n      &#39;tertiaryColor&#39;: &#39;#f8fafc&#39;,\n      &#39;tertiaryBorderColor&#39;: &#39;#94a3b8&#39;,\n      &#39;fontSize&#39;: &#39;12px&#39;,\n      &#39;fontFamily&#39;: &#39;Arial, sans-serif&#39;\n    },\n    &#39;er&#39;: {\n      &#39;diagramPadding&#39;: 20,\n      &#39;layoutDirection&#39;: &#39;TB&#39;,\n      &#39;useMaxWidth&#39;: true\n    },\n    &#39;flowchart&#39;: {\n      &#39;curve&#39;: &#39;basis&#39;\n    }\n  }\n}%%\n\nerDiagram\n\n    %% ----------------------------------------------------\n    %% DOMAIN 1: CORE IDENTITY\n    %% ----------------------------------------------------\n    subgraph DOMAIN_IDENTITY [\&quot; 1. USER &amp; IDENTITY DOMAIN \&quot;]\n        users ||--|| user_profiles : \&quot;1:1\&quot;\n        users ||--|| trainer_profiles : \&quot;1:1\&quot;\n        users ||--o{ user_sessions : \&quot;1:N\&quot;\n        users ||--o{ body_metrics : \&quot;1:N\&quot;\n    end\n\n    %% ----------------------------------------------------\n    %% DOMAIN 2: MEMBERSHIP &amp; ATTENDANCE\n    %% ----------------------------------------------------\n    subgraph DOMAIN_MEMBERSHIP [\&quot; 2. MEMBERSHIP &amp; ATTENDANCE DOMAIN \&quot;]\n        membership_plans ||--o{ memberships : \&quot;1:N\&quot;\n        gym_rate_plans ||--o{ gym_access_passes : \&quot;1:N\&quot;\n        gym_access_passes ||--o{ gym_attendance : \&quot;1:N\&quot;\n        gym_attendance ||--o{ attendance_attempts : \&quot;1:N\&quot;\n    end\n\n    %% ----------------------------------------------------\n    %% DOMAIN 3: TRAINING &amp; BOOKING\n    %% ----------------------------------------------------\n    subgraph DOMAIN_TRAINING [\&quot; 3. TRAINING &amp; BOOKING DOMAIN \&quot;]\n        training_services ||--o{ training_service_plans : \&quot;1:N\&quot;\n        training_service_plans ||--o{ trainer_assignments : \&quot;1:N\&quot;\n        trainer_schedules ||--o{ bookings : \&quot;1:N\&quot;\n        trainer_assignments ||--o{ training_sessions : \&quot;1:N\&quot;\n        trainer_assignments ||--o{ workout_sessions : \&quot;1:N\&quot;\n    end\n\n    %% ----------------------------------------------------\n    %% DOMAIN 4: AI &amp; WORKOUT LOGS\n    %% ----------------------------------------------------\n    subgraph DOMAIN_AI [\&quot; 4. AI TRAINER &amp; WORKOUT LOGS \&quot;]\n        chat_sessions ||--o{ chat_messages : \&quot;1:N\&quot;\n        chat_sessions ||--o{ ai_recommendations : \&quot;1:N\&quot;\n        workout_sessions ||--o| ai_recommendations : \&quot;0..1\&quot;\n        workout_sessions ||--o{ session_exercises : \&quot;1:N\&quot;\n        session_exercises ||--o{ session_exercise_equipment : \&quot;1:N\&quot;\n        session_exercises ||--o{ workout_logs : \&quot;1:N\&quot;\n        workout_logs ||--|{ workout_log_set : \&quot;1:N\&quot;\n    end\n\n    %% ----------------------------------------------------\n    %% DOMAIN 5: SALES, INVENTORY &amp; EQUIPMENT\n    %% ----------------------------------------------------\n    subgraph DOMAIN_SALES [\&quot; 5. SALES, INVENTORY &amp; EQUIPMENT \&quot;]\n        payments ||--|{ payment_items : \&quot;1:N\&quot;\n        product_categories ||--o{ products : \&quot;1:N\&quot;\n        products ||--o{ payment_items : \&quot;1:N\&quot;\n        add_on_services ||--o{ payment_items : \&quot;1:N\&quot;\n        equipment_categories ||--o{ equipment : \&quot;1:N\&quot;\n        equipment ||--o{ equipment_maintendance_logs : \&quot;1:N\&quot;\n        equipment ||--o{ session_exercise_equipment : \&quot;1:N\&quot;\n    end\n\n    %% ----------------------------------------------------\n    %% CROSS-DOMAIN ANCHORS (USERS &amp; TRANSACTIONS)\n    %% ----------------------------------------------------\n    users ||--o{ memberships : \&quot;member\&quot;\n    users ||--o{ gym_access_passes : \&quot;owner\&quot;\n    users ||--o{ gym_attendance : \&quot;check-in\&quot;\n    users ||--o{ bookings : \&quot;client/trainer\&quot;\n    users ||--o{ trainer_assignments : \&quot;client/trainer\&quot;\n    users ||--o{ chat_sessions : \&quot;owner\&quot;\n    users ||--o{ workout_logs : \&quot;user\&quot;\n    users ||--o{ payments : \&quot;payer/reviewer\&quot;\n    users ||--o{ audit_logs : \&quot;actor\&quot;\n\n    membership_plans ||--o{ payment_items : \&quot;item\&quot;\n    gym_rate_plans ||--o{ payment_items : \&quot;item\&quot;\n    training_service_plans ||--o{ payment_items : \&quot;item\&quot;\n    payments ||--o{ gym_access_passes : \&quot;payment\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yoNKWIDd8qABSJTO1Fng-539">
